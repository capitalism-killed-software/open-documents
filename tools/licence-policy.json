{
  "about": "What may be in the dependency tree. Everything shipped is Apache-2.0, so dependencies must be permissive. See docs/licensing.md.",
  "allow": [
    "MIT",
    "MIT-0",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "0BSD",
    "Zlib",
    "BlueOak-1.0.0",
    "CC0-1.0",
    "Unlicense",
    "Python-2.0",
    "CC-BY-4.0",
    "OFL-1.1"
  ],
  "deny": {
    "mupdf": "MuPDF is AGPL-3.0",
    "mupdf-js": "MuPDF is AGPL-3.0",
    "@mupdf/*": "MuPDF is AGPL-3.0",
    "pymupdf": "PyMuPDF is AGPL-3.0",
    "pymupdf4llm": "AGPL-3.0",
    "pdf2docx": "needs PyMuPDF, which is AGPL-3.0",
    "fitz": "PyMuPDF's import name",
    "ghostscript4js": "Ghostscript is AGPL-3.0",
    "ghostscript-node": "Ghostscript is AGPL-3.0",
    "gs": "Ghostscript is AGPL-3.0",
    "imagemagick": "its PDF support runs Ghostscript",
    "gm": "GraphicsMagick and ImageMagick hand PDFs to Ghostscript",
    "pdf2pic": "runs GraphicsMagick and Ghostscript",
    "pdf2image": "Poppler is GPL",
    "pdf-poppler": "Poppler is GPL",
    "node-poppler": "Poppler is GPL",
    "poppler-simple": "Poppler is GPL",
    "itext": "iText is AGPL-3.0",
    "@itext/*": "iText is AGPL-3.0",
    "hexapdf": "HexaPDF is AGPL-3.0",
    "pandoc": "GPL-2.0-or-later",
    "node-pandoc": "Pandoc is GPL-2.0-or-later",
    "extract-msg": "GPL-3.0",
    "marker-pdf": "model weights forbid competing products",
    "surya-ocr": "model weights forbid competing products",
    "mineru": "custom licence terms",
    "magic-pdf": "MinerU, custom licence terms",
    "nougat-ocr": "weights are non-commercial",
    "sharp": "ships libvips, which is LGPL"
  },
  "exceptions": {
    "@embedpdf/plugin-form@2.14.2": "MIT: the package ships an MIT LICENSE file (CloudPDF, like the other EmbedPDF packages) but its package.json has no licence field"
  }
}
