# The standard image plus the Docling worker, for PDF to Markdown, HTML, JSON and Excel.
# About two gigabytes larger: Python, PyTorch for the CPU, and Docling's layout and table models.
#
#   docker build -f docker/Dockerfile -t open-documents .
#   docker build -f docker/Dockerfile.full --build-arg BASE=open-documents -t open-documents:full .

ARG BASE=open-documents
FROM ${BASE}

USER root
COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv
# a Python of its own, the worker's packages exactly as locked, and the models, all at build
# time: nothing is downloaded while the server runs
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PROJECT_ENVIRONMENT=/opt/docling \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
RUN cd packages/node/python \
 && uv sync --frozen --no-dev --no-install-project \
 && /opt/docling/bin/docling-tools models download layout tableformer -o /opt/docling-models \
 && chmod -R a+rX /opt/python /opt/docling /opt/docling-models

USER node
ENV OPENDOCS_PYTHON=/opt/docling/bin/python \
    OPENDOCS_DOCLING_MODELS=/opt/docling-models
