{
  "name": "open-documents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"packages/*/test/**/*.test.js\" \"tools/test/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/test/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90 \"packages/*/test/**/*.test.js\" \"tools/test/*.test.js\"",
    "licences": "node tools/check-licences.js",
    "check": "npm run lint && npm run licences && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "esbuild": "0.27.3",
    "eslint": "9.39.2",
    "globals": "17.0.0"
  }
}
